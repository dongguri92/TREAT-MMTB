# =============================================================================
# TREAT-MMTB 2026 — Task 1 submission image (participant side)
# Python 3.10 / CUDA 11.8 / cuDNN 8 — INFERENCE ONLY
# =============================================================================
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# --- System dependencies ----------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3.10-dev \
        libglib2.0-0 \
        libgl1 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN python -m pip install --no-cache-dir --upgrade pip

# timm이 torchvision을 요구하므로 Torch와 함께 고정
RUN python -m pip install --no-cache-dir \
    torch==2.1.0 torchvision==0.16.0 \
    --index-url https://download.pytorch.org/whl/cu118

# --- Python dependencies ----------------------------------------------------
COPY requirements_task1.txt .
RUN python -m pip install --no-cache-dir --upgrade pip
RUN python -m pip install --no-cache-dir -r requirements_task1.txt \
    && python -m pip check

# --- Code + weights (baked into the image; container runs offline) ----------
COPY . .

# 필수 파일이 실제 이미지 안에 들어갔는지 빌드 단계에서 확인
RUN test -s /workspace/weights/best_evax_cls.pth \
    && test -s /workspace/predict_task1.py \
    && test -s /workspace/models_evax.py

# 체크포인트 구조와 모델 구조가 실제로 일치하는지 CPU에서 확인
RUN python - <<'PY'
import torch
from predict_task1 import load_model

model = load_model(
    "/workspace/weights/best_evax_cls.pth",
    torch.device("cpu"),
)
print("Model and checkpoint load: OK")
PY

# Fixed entrypoint and I/O paths. Do NOT change /input or /output.
ENTRYPOINT ["python", "predict_task1.py", \
            "--input", "/input", \
            "--output", "/output", \
            "--weights", "/workspace/weights/best_evax_cls.pth"]
